# Clave patronal larga y privada. Configúrala en backend/.env y en las variables
# de entorno del hosting; nunca la publiques ni la pongas en el frontend.
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/cafe_exquisito
JWT_SECRET=replace-with-a-long-random-secret
EMPLOYER_ACCESS_KEY=replace-with-a-separate-random-secret
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional integrations. Leave blank when they are not configured.
GEMINI_API_KEY=
STRIPE_SECRET_KEY=
N8N_WEBHOOK_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used only by the local admin test-account script. Keep the real values in .env.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
