# Solo hace falta si la web y la API se publican en hosts distintos.
# Incluye la ruta de API; por ejemplo: https://api.example.com/api
VITE_API_URL=
# Prueba local opcional: reservas nuevas en Django, con administración independiente.
VITE_DJANGO_RESERVATIONS=false
# Muestra productos Django en la página principal, solo para consultar.
VITE_DJANGO_CATALOG=false
# Solo con el catálogo Django activado: pedido experimental con sesión Django.
VITE_DJANGO_CHECKOUT=false
# Inicio de sesión independiente de Django; solo para pruebas
VITE_DJANGO_AUTH=false
# Muestra promociones de Django; la administración React sigue usando Express.
VITE_DJANGO_PROMOTIONS=false
# Prueba de eventos Django; las reservas requieren también VITE_DJANGO_AUTH=true.
VITE_DJANGO_EVENTS=false
# Lee los ajustes visuales de Django, editados desde su administración.
VITE_DJANGO_SETTINGS=false
# Los perfiles públicos del equipo se administran en Django; la contratación sigue en Express.
VITE_DJANGO_TEAM=false
# Solicitudes en Django; invitaciones disponibles con el acceso Django activado.
VITE_DJANGO_STAFF_APPLICATIONS=false
# Búsqueda sencilla en el menú Django; no es IA y no utiliza Express.
VITE_DJANGO_CHAT=false
